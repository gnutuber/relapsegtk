#!/usr/bin/env bash
set -euo pipefail

APPDIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GTK_DATA_PREFIX="$APPDIR/usr"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"
unset GIO_EXTRA_MODULES GTK_PATH

# Loader caches contain absolute paths, so create one for this mount location.
relapse_runtime_dir="$(mktemp -d "${TMPDIR:-/tmp}/relapsegtk-appimage.XXXXXX")"
trap 'rm -rf -- "$relapse_runtime_dir"' EXIT
export GDK_PIXBUF_MODULE_FILE="$relapse_runtime_dir/loaders.cache"
export GDK_PIXBUF_MODULEDIR="$APPDIR/usr/lib"
svg_loader=""
for candidate in "$APPDIR/usr/lib/libpixbufloader_svg.so" "$APPDIR/usr/lib/libpixbufloader-svg.so"; do
    if [[ -f "$candidate" ]]; then
        svg_loader="$candidate"
        break
    fi
done
[[ -n "$svg_loader" ]] || { echo "The bundled SVG loader is missing." >&2; exit 1; }
"$APPDIR/usr/bin/gdk-pixbuf-query-loaders" "$svg_loader" > "$GDK_PIXBUF_MODULE_FILE"

"$APPDIR/usr/bin/relapsegtk" "$@" &
relapse_pid=$!
trap 'kill -TERM "$relapse_pid" 2>/dev/null || true' TERM
trap 'kill -INT "$relapse_pid" 2>/dev/null || true' INT
set +e
wait "$relapse_pid"
status=$?
if kill -0 "$relapse_pid" 2>/dev/null; then
    wait "$relapse_pid"
    status=$?
fi
exit "$status"
